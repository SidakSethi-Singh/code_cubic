# ============================
# EdgeMind .gitignore
# ============================

# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~
Thumbs.db
.DS_Store

# Node / UI
ui/node_modules/
ui/.next/
ui/out/
ui/build/
ui/.env.local
node_modules/
.next/

# Runtime SQLite & Vector DB binary storage
*.sqlite
*.sqlite3
*.db
*.wal
data/devices/
data/hub_state.json
data/models/
data/generated/
data/golden/
data/eval/

# Distribution & packaging
dist/
build/
*.egg-info/
*.egg

# Logs
*.log
npm-debug.log*
yarn-debug.log*
